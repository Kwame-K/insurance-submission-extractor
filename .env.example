LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional: retry with this provider when the primary fails or omits explicit fields.
# Fallback results always set review_required=true.
#LLM_FALLBACK_PROVIDER=groq

# Optional: append one content-free JSON line per extraction (see README, Observability).
#EXTRACTION_LOG_PATH=logs/extractions.jsonl

# Optional token prices in USD per million tokens, copied from your provider's price page.
# Cost is computed for a provider only when both its input and output prices are set.
#GEMINI_INPUT_PRICE_PER_MILLION_USD=
#GEMINI_OUTPUT_PRICE_PER_MILLION_USD=
#GROQ_INPUT_PRICE_PER_MILLION_USD=
#GROQ_OUTPUT_PRICE_PER_MILLION_USD=
